# Copy to .env and fill in. .env is git-ignored; this template is committed.
# Use trade-only API keys with withdrawals DISABLED and an IP allow-list.

# Exchange
EXCHANGE_NAME=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (e.g. OKX, KuCoin) also require a passphrase
EXCHANGE_API_PASSWORD=
EXCHANGE_TESTNET=true

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to send commands
TELEGRAM_ALLOWED_CHAT_IDS=

# AI layer (when added)
ANTHROPIC_API_KEY=
