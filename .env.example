# Copy this file to .env and fill in your keys. .env is git-ignored; never commit it.
#
# testnet: keys from https://testnet.bybit.com (API Management)
# demo:    keys from the Demo Trading tab of your bybit.com account (mainnet prices, fake funds)
# mainnet: REAL funds
BYBIT_ENV=testnet

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
